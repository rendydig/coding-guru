# Normalize line endings: LF in the repository, LF in the working tree.
# This makes `git add` stop warning about LF -> CRLF conversion and keeps the
# repo identical regardless of each contributor's core.autocrlf setting.
* text=auto eol=lf

# Binary files — Git must never apply line-ending conversion to these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.vsix binary
*.zip binary
