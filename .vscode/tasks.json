{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "watch",
      "detail": "esbuild in watch mode (background task for the debugger)",
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "group": "watch",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "esbuild",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+):\\s+(error|warning):\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[esbuild\\] watching",
          "endsPattern": "^\\[esbuild\\] build finished"
        }
      }
    },
    {
      "label": "build",
      "detail": "One-shot production build",
      "type": "npm",
      "script": "build",
      "group": "build",
      "problemMatcher": ["$tsc"]
    }
  ]
}
